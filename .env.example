GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SCRIPT_URL=
# Mesmo segredo aleatório (mínimo de 32 caracteres) configurado como
# BACKEND_SHARED_SECRET nas Propriedades do script dos dois Apps Scripts.
APPS_SCRIPT_SHARED_SECRET=
# Quantidade exata de proxies reversos entre o cliente e o Express (ex.: 1 no Render).
# Deixe vazio somente quando o serviço for acessado diretamente, sem proxy.
TRUST_PROXY_HOPS=
# Habilite apenas quando a aplicação precisar rodar embutida em iframe de outro site.
EMBED_THIRD_PARTY_COOKIES=false
MARIA_PASSWORD=
# URL for Motoboy actions
MOTOBOY_GOOGLE_SCRIPT_URL=
RECEPTION_PASSWORD=
# Obrigatório: use valor aleatório com no mínimo 32 caracteres. Trocar este valor invalida sessões existentes.
SESSION_SECRET=
# Obrigatórias: use senhas exclusivas com no mínimo 12 caracteres.
TI_PASSWORD=
# Token de autorização para emissão automatizada de relatórios em PDF (ex: n8n)
REPORT_API_TOKEN=
# Use 'supabase' para usar o Supabase no backend de Motoboy, ou vazio/'apps_script' para manter via Google Apps Script
MOTOBOY_STORAGE=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
